{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "__MSG_extensionActionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/translator-inactive-16.png",
      "32": "icons/translator-inactive-32.png",
      "48": "icons/translator-inactive-48.png",
      "128": "icons/translator-inactive-128.png"
    }
  },
  "icons": {
    "16": "icons/translator-16.png",
    "32": "icons/translator-32.png",
    "48": "icons/translator-48.png",
    "128": "icons/translator-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared-utils.js",
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
